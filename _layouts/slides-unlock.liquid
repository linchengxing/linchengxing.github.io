{% assign is_zh = false %}{% if page.lang == 'zh-CN' %}{% assign is_zh = true %}{% endif %}
<!doctype html>
<html lang="{{ page.lang | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="theme-color" content="#ff77a8">
  <title>{% if is_zh %}个人介绍 · 密码解锁{% else %}Personal introduction · Unlock{% endif %}</title>
  <style>
    :root { color-scheme: light; font-family: "Courier New", "PingFang SC", "Microsoft YaHei", monospace; background: #f4f4f4; color: #1a1c2c; }
    * { box-sizing: border-box; border-radius: 0; }
    body { margin: 0 auto; max-width: 1120px; padding: 0 32px; }
    header { min-height: 76px; display: flex; align-items: center; justify-content: space-between; border-bottom: 4px solid #1a1c2c; gap: 24px; font-size: 13px; font-weight: bold; }
    a { color: #7e2553; text-underline-offset: 4px; }
    main { min-height: calc(100svh - 80px); display: flex; align-items: center; justify-content: center; padding: 40px 0; }
    .unlock-card { width: min(100%, 490px); border: 3px solid #1a1c2c; box-shadow: 7px 7px 0 #1a1c2c; background: white; padding: 36px; }
    .eyebrow { color: #7e2553; font-size: 11px; letter-spacing: 1px; font-weight: bold; margin: 0 0 20px; }
    h1 { font-size: 32px; margin: 0 0 12px; line-height: 1.2; }
    .description { font-size: 14px; line-height: 1.7; margin: 0 0 28px; }
    label { display: block; font-size: 12px; font-weight: bold; margin-bottom: 8px; }
    input { width: 100%; font: inherit; padding: 12px; border: 2px solid #1a1c2c; background: #f4f4f4; font-size: 16px; }
    button { width: 100%; margin-top: 14px; font: inherit; font-weight: bold; background: #ff77a8; color: #1a1c2c; padding: 12px; border: 2px solid #1a1c2c; box-shadow: 3px 3px 0 #1a1c2c; cursor: pointer; }
    button:disabled { opacity: .6; cursor: wait; }
    input:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid #7e2553; outline-offset: 4px; }
    .status { min-height: 24px; font-size: 12px; line-height: 1.7; margin: 16px 0 0; color: #7e2553; }
    @media(max-width: 540px) { body { padding: 0 20px; } header { font-size: 11px; gap: 12px; } .unlock-card { padding: 28px 24px; } h1 { font-size: 27px; } }
  </style>
  <script src="{{ '/assets/js/slides-unlock.js' | relative_url }}?v={{ site.time | date: '%s' }}" defer></script>
</head>
<body data-slides-language="{{ page.lang | default: 'en' }}" data-slides-manifest="{{ '/assets/protected-slides/manifest.json' | relative_url }}">
  <header><a href="{{ '/' | relative_url }}">{% if is_zh %}← 主页{% else %}← Home{% endif %}</a><span>{% if is_zh %}林程星 / 个人介绍{% else %}Chengxing Lin / Personal introduction{% endif %}</span><a id="unlock-language-switch" href="{% if is_zh %}{{ '/slides/' | relative_url }}{% else %}{{ '/slides-zh/' | relative_url }}{% endif %}">{% if is_zh %}English{% else %}中文{% endif %}</a></header>
  <main><section class="unlock-card" aria-labelledby="unlock-title">
    <p class="eyebrow">{% if is_zh %}个人介绍 / 访问解锁{% else %}PERSONAL INTRODUCTION / ACCESS{% endif %}</p>
    <h1 id="unlock-title">{% if is_zh %}输入密码，开始浏览。{% else %}Enter to explore.{% endif %}</h1>
    <p class="description">{% if is_zh %}这份个人介绍需要密码才能查看。{% else %}This personal introduction is password protected.{% endif %}</p>
    <form id="unlock-form"><label for="slides-password">{% if is_zh %}访问密码{% else %}Password{% endif %}</label><input id="slides-password" type="password" autocomplete="current-password" required><button id="unlock-button" type="submit">{% if is_zh %}解锁 slides →{% else %}Unlock slides →{% endif %}</button></form>
    <p class="status" id="unlock-status" role="status" aria-live="polite"></p>
    <noscript>{% if is_zh %}请启用 JavaScript 后输入密码解锁。{% else %}Enable JavaScript to unlock this presentation.{% endif %}</noscript>
  </section></main>
</body>
</html>
